<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AdoPrView</AssemblyName>
    <RootNamespace>AdoPrView</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.1.7</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdoPrView.FixSupervisor\AdoPrView.FixSupervisor.csproj" ReferenceOutputAssembly="false" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.34" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <InternalsVisibleTo Include="AdoPrView.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="VideoAssets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\cat-photos.txt" Link="licenses\cat-photos.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="app.ico" />
    <None Include="..\..\licenses\Primer\LICENSE.txt" Link="licenses\Primer\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\Mermaid\LICENSE" Link="licenses\Mermaid\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyFixSupervisorBuild" AfterTargets="Build">
    <ItemGroup>
      <FixSupervisorBuild Include="..\AdoPrView.FixSupervisor\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)FixSupervisor" />
    <Copy SourceFiles="@(FixSupervisorBuild)" DestinationFiles="@(FixSupervisorBuild->'$(TargetDir)FixSupervisor\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishFixSupervisor" AfterTargets="Publish">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\fix-supervisor-publish\$(Configuration)\$(RuntimeIdentifier)" />
    <MSBuild Projects="..\AdoPrView.FixSupervisor\AdoPrView.FixSupervisor.csproj" Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(MSBuildProjectDirectory)\obj\fix-supervisor-publish\$(Configuration)\$(RuntimeIdentifier)\" />
    <ItemGroup>
      <FixSupervisorPublish Include="$(MSBuildProjectDirectory)\obj\fix-supervisor-publish\$(Configuration)\$(RuntimeIdentifier)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)FixSupervisor" />
    <Copy SourceFiles="@(FixSupervisorPublish)" DestinationFiles="@(FixSupervisorPublish->'$(PublishDir)FixSupervisor\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>

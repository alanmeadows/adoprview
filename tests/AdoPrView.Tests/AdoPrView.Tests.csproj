<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AdoPrView\AdoPrView.csproj" />
  </ItemGroup>
  <Target Name="CopyFixSupervisorFixture" AfterTargets="Build">
    <ItemGroup>
      <FixSupervisorFixture Include="..\..\src\AdoPrView\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\FixSupervisor\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)FixSupervisor" />
    <Copy SourceFiles="@(FixSupervisorFixture)" DestinationFiles="@(FixSupervisorFixture->'$(TargetDir)FixSupervisor\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
